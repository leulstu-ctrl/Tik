<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Crypto Invest</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="#">CRYPTO INVEST</a>
            <div class="d-flex">
                <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <!-- Notifications -->
        <% if (error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success" role="alert"><%= success %></div>
        <% } %>

        <div class="row">
            <!-- Balance & Deposit -->
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header">Your Balance</div>
                    <div class="card-body text-center">
                        <div class="balance-display">$<%= user.balance.toFixed(2) %></div>
                        <hr class="border-secondary">
                        <form action="/deposit" method="POST" class="mt-3">
                            <label for="amount" class="form-label text-start w-100">Deposit Amount</label>
                            <div class="input-group mb-3">
                                <span class="input-group-text bg-secondary border-secondary text-white">$</span>
                                <input type="number" class="form-control" name="amount" min="1" step="0.01" required>
                                <button class="btn btn-neon" type="submit">Confirm</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Investment Plans -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header">Invest Now</div>
                    <div class="card-body">
                        <form action="/invest" method="POST">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="plan" class="form-label">Select Plan</label>
                                    <select class="form-select" name="plan" id="plan" required onchange="updateReturn()">
                                        <option value="gold" data-rate="0.05">Gold Plan - 5% Daily</option>
                                        <option value="platinum" data-rate="0.10">Platinum Plan - 10% Daily</option>
                                        <option value="diamond" data-rate="0.15">Diamond Plan - 15% Daily</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="investAmount" class="form-label">Amount</label>
                                    <input type="number" class="form-control" name="amount" id="investAmount" min="10" step="0.01" required placeholder="Min $10" oninput="updateReturn()">
                                </div>
                                <div class="col-12">
                                    <div class="alert alert-dark border-secondary">
                                        Potential Return: <span id="potentialReturn" class="text-neon fw-bold">$0.00</span>
                                    </div>
                                </div>
                                <div class="col-12 text-end">
                                    <button type="submit" class="btn btn-neon px-4">Invest</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Investment History -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header">Active Investments</div>
                    <div class="card-body">
                        <% if (investments.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-dark table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Plan</th>
                                            <th>Amount</th>
                                            <th>Potential Return</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% investments.forEach(function(inv) { %>
                                            <tr>
                                                <td><%= new Date(inv.created_at).toLocaleDateString() %></td>
                                                <td><%= inv.plan_name %></td>
                                                <td>$<%= inv.amount.toFixed(2) %></td>
                                                <td class="text-neon">$<%= inv.potential_return.toFixed(2) %></td>
                                                <td><span class="badge bg-success"><%= inv.status %></span></td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <p class="text-center text-muted my-3">No active investments yet.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function updateReturn() {
            const planSelect = document.getElementById('plan');
            const amountInput = document.getElementById('investAmount');
            const returnDisplay = document.getElementById('potentialReturn');

            const rate = parseFloat(planSelect.options[planSelect.selectedIndex].getAttribute('data-rate'));
            const amount = parseFloat(amountInput.value);

            if (!isNaN(amount) && amount > 0) {
                const total = amount + (amount * rate);
                returnDisplay.innerText = '$' + total.toFixed(2);
            } else {
                returnDisplay.innerText = '$0.00';
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
